WXL_UPDATE_FIELD(Object, OBJECT_FIELD_GUID, Guid, 0x0000, 2, guid, 0x001, none)
WXL_UPDATE_FIELD(Object, OBJECT_FIELD_TYPE, Type, 0x0002, 1, u32, 0x001, none)
