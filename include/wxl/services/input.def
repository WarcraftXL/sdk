//
// wxl.input as data: one row per member of wxl_input_api, in member order. The shapes and their
// columns are described in wxl/services/rows.hpp.

#ifndef WXL_API
#error "define the WXL_API shapes (wxl/services/rows.hpp lists them) before including input.def"
#endif

WXL_API_SERVICE(input, WXL_INPUT_SERVICE, WXL_INPUT_SERVICE_VERSION, (0, 1, 24), open,
                "The pointer, for a mod that steers with the mouse: captured at the centre of the window, or free. Main thread only.")

WXL_API(input, capture_cursor, CaptureCursor, result, (boolean captured), shim, generated,
        "Hides the pointer and holds it at the centre of the window, where the game still picks and clicks (true), or gives the mod's capture back (false).")
WXL_API(input, cursor_captured, CursorCaptured, boolean, (), generated, generated,
        "Whether some mod holds the pointer.")
WXL_API(input, pointer_over_world, PointerOverWorld, boolean, (), generated, generated,
        "Whether the pointer is over the world rather than a frame of the interface.")
WXL_API_SINCE(input, block_mouse_look, (0, 1, 25))
WXL_API(input, block_mouse_look, BlockMouseLook, result, (boolean blocked), shim, generated,
        "Keeps the game out of its own mouse look (true): a held mouse button turns nothing and hides nothing, a click still selects or acts; false gives the mod's block back.")
WXL_API(input, mouse_look_blocked, MouseLookBlocked, boolean, (), generated, generated,
        "Whether some mod keeps the game out of its mouse look.")
WXL_API_SINCE(input, capture_cursor_at, (0, 1, 29))
WXL_API(input, capture_cursor_at, CaptureCursorAt, result, (f64 x, f64 y), shim, generated,
        "Hides the pointer and holds it at a point of the window, x from the left and y from the top, 0 to 1 ((0.5, 0.5) is the centre); the game picks and clicks there.")
WXL_API(input, capture_point, CapturePoint, out<vec3>, (), generated, generated,
        "Where the captured pointer is held: x from the left, y from the top, 0 to 1, z 0; not_found when no mod holds it.")

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
