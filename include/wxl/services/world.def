//
// wxl.world as data: one row per member of wxl_world_api, in member order. The shapes and their
// columns are described in wxl/services/rows.hpp.

#ifndef WXL_API
#error "define the WXL_API shapes (wxl/services/rows.hpp lists them) before including world.def"
#endif

WXL_API_SERVICE(world, WXL_WORLD_SERVICE, WXL_WORLD_SERVICE_VERSION, (0, 1, 24), open,
                "Questions about the world's geometry. Main thread only.")

WXL_API(world, trace, Trace, found<vec3>, (vec3 start, vec3 finish, opt<u32> flags), generated, by_hand,
        "The first point of the world's geometry (ground, buildings, doodads) between two points, or nil when the way is clear; flags is the client's hit-test mask, the camera's when left out.")
