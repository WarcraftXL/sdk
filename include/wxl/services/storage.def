// wxl.storage as data: one row per member of wxl_storage_api, in member order. The shapes and
// their columns are described in wxl/services/rows.hpp.

#ifndef WXL_API
#error "define the WXL_API shapes (wxl/services/rows.hpp lists them) before including storage.def"
#endif

WXL_API_SERVICE(storage, WXL_STORAGE_SERVICE, WXL_STORAGE_SERVICE_VERSION, (0, 1, 5), open,
                "The client's files, whatever they are packed in: named as the client names them.")

// An open file, from open, closed by close; a Lua mod's are closed when it lets go of them.
WXL_API_RESOURCE(storage, File, wxl_handle, WXL_HANDLE_NONE)

WXL_API(storage, exists, Exists, boolean, (str path), generated, generated,
        "Whether a name resolves to a file, in an archive or in a folder.")
WXL_API(storage, size, Size, out<u64>, (str path), generated, generated,
        "A file's length in bytes, without reading it.")
WXL_API(storage, read, Read, whole_bytes, (str path), generated, by_hand,
        "A whole file.")
WXL_API(storage, open, Open, File, (str path), generated, by_hand,
        "Opens a file to read it a piece at a time.")
WXL_API(storage, read_at, ReadAt, read_bytes, (File file, u64 offset), generated, by_hand,
        "Reads at an offset: as many bytes as asked, or what is left.")
WXL_API_CLOSE(storage, close, Close, none, File, collected,
              "Closes the file; one the mod lets go of is closed for it.")
WXL_API(storage, add_search_path, AddSearchPath, result, (str directory, i32 priority), shim, generated,
        "Adds a folder inside the client's folder to the files searched, until the mod removes it or "
        "goes: the higher priority wins a name, the client's own data is 0.")
WXL_API(storage, mount_archive, MountArchive, result, (str path, i32 priority), generated, generated,
        "Adds an archive to the files searched, at a priority as AddSearchPath's.")
WXL_API(storage, find, Find, list<wxl_str>, (str pattern), generated, by_hand,
        "The names matching a pattern, * standing for any run of characters, each once.")
WXL_API_SINCE(storage, remove_search_path, (0, 1, 10))
WXL_API(storage, remove_search_path, RemoveSearchPath, result, (str directory), shim, generated,
        "Takes a folder the mod added back out of the files searched; not_found for one it did not add.")
WXL_API_SINCE(storage, redirect, (0, 1, 15))
WXL_API(storage, redirect, Redirect, result, (str from, str to), shim, generated,
        "Opens one name in place of another, on every thread, until the mod takes it back or goes: "
        "the latest of two mods' wins.")
WXL_API(storage, unredirect, Unredirect, result, (str from), shim, generated,
        "Takes the mod's redirect of a name back; not_found for one it did not redirect.")
WXL_API_SINCE(storage, add_provider, (0, 1, 19))
WXL_API(storage, add_provider, AddProvider, out<u64>, (provider provider, i32 priority), native, by_hand, "")
WXL_API(storage, remove_provider, RemoveProvider, result, (u64 provider), native, by_hand, "")
WXL_API(storage, add_transform, AddTransform, out<u64>, (transform transform, i32 priority), native, by_hand, "")
WXL_API(storage, remove_transform, RemoveTransform, result, (u64 transform), native, by_hand, "")
WXL_API(storage, serve, Serve, result, (str path, bytes data, bytes_size size, i32 priority), shim, by_hand,
        "Serves bytes under a name, on every thread, until the mod takes them back or goes: the client "
        "reads them as one of its files. Priority as AddSearchPath's.")
WXL_API(storage, unserve, Unserve, result, (str path), shim, generated,
        "Takes back what the mod serves under a name; not_found for one it does not serve.")
WXL_API_SINCE(storage, hash_file, (0, 1, 22))
WXL_API(storage, hash_file, HashFile, out<file_hash>, (str path, u32 flags), shim, by_hand,
        "The MD5 and length of a file as the client would read it, and the layer that holds it; flags 1 "
        "reads it again rather than answer from what was kept.")
WXL_API(storage, hash_file_async, HashFileAsync, out<u64>, (str path, u32 flags, hash_fn fn, ptr user), shim, by_hand,
        "HashFile on a thread of the runtime's: the answer comes later, on the main thread.")
WXL_API(storage, override_file, OverrideFile, result, (str path, str with), shim, generated,
        "Replaces a file of the client with another name, on every thread, for opens and existence checks, "
        "until the mod restores it or goes: the latest of two mods' wins.")
WXL_API(storage, restore_file, RestoreFile, result, (str path), shim, generated,
        "Takes the mod's override of a name back; not_found for one it did not override.")
WXL_API(storage, reload_asset, ReloadAsset, out<asset_reload>, (str path), shim, by_hand,
        "Makes the client read a model or a texture it holds again, so a file that changed shows.")

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
