//
// wxl.data as data: one row per member of wxl_data_api, in member order. The shapes and their
// columns are described in wxl/services/rows.hpp.

#ifndef WXL_API
#error "define the WXL_API shapes (wxl/services/rows.hpp lists them) before including data.def"
#endif

WXL_API_SERVICE(data, WXL_DATA_SERVICE, WXL_DATA_SERVICE_VERSION, (0, 1, 5), open,
                "The client's databases, served from a mod's own files before the client reads them.")

WXL_API(data, serve_table, ServeTable, result, (str table, str path), generated, generated,
        "Serves a table from a file the client can read instead of its own: before the client reads it.")
WXL_API(data, restore_table, RestoreTable, result, (str table), generated, generated,
        "Gives a table back, so the client's own file is used again.")
WXL_API(data, served_from, ServedFrom, str, (str table), generated, generated,
        "What a table is served from, empty when it is the client's own file.")
WXL_API(data, is_loaded, IsLoaded, boolean, (str table), generated, generated,
        "Whether the client has read a table already, in which case serving it comes too late.")

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
