//
// wxl.gx as data: one row per member of wxl_gx_api, in member order. The shapes and their columns
// are described in wxl/services/rows.hpp.
//
// The device's own members reach no script; api does.

#ifndef WXL_API
#error "define the WXL_API shapes (wxl/services/rows.hpp lists them) before including gx.def"
#endif

WXL_API_SERVICE(gx, WXL_GX_SERVICE, WXL_GX_SERVICE_VERSION, (0, 1, 20), raw,
                "Which device the client draws with, and its Direct3D 9 device for a mod that draws with it.")

WXL_API(gx, d3d9_device, D3d9Device, ptr, (), native, generated, "")
WXL_API(gx, invalidate_state, InvalidateState, none, (), native, generated, "")
WXL_API_SINCE(gx, api, (0, 1, 33))
WXL_API(gx, api, Api, enumeration<wxl_gx_backend>, (), generated, generated,
        "The API the client's device runs on: none, d3d9, d3d9ex, opengl or vulkan.")

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
