//
// wxl.m2 as data: one row per member of wxl_m2_api, in member order. The shapes and their columns
// are described in wxl/services/rows.hpp.
//
// A model a mod makes is a resource: a script holds it as a wxl.Model, whose methods are the rows
// taking one first, and gives it back with Release or when the mod unloads.

#ifndef WXL_API
#error "define the WXL_API shapes (wxl/services/rows.hpp lists them) before including m2.def"
#endif

WXL_API_SERVICE(m2, WXL_M2_SERVICE, WXL_M2_SERVICE_VERSION, (0, 1, 20), raw,
                "The models objects draw with, what a character wears, and models a mod makes and hangs on them. Main thread only.")

WXL_API_RESOURCE(m2, Model, void*, nullptr)

WXL_API(m2, object_model, ObjectModel, ptr, (object object), generated, generated,
        "The model an object draws with, followed up what it hangs on (a mounted player answers its mount); nil, \"not_found\" for none.")
WXL_API(m2, item_display, ItemDisplay, out<m2_item_display>, (u32 display_id), native, by_hand, "")
WXL_API(m2, race_prefix, RacePrefix, out<str>, (u32 race_id), generated, generated,
        "A race's prefix in model file names (\"Hu\", \"Or\", \"Sc\"), from ChrRaces.dbc.")
WXL_API(m2, create_model, CreateModel, Model, (ptr scene_model, str path), generated, generated,
        "Makes a model of a file in the scene of the model given, for this mod: hang it on something with Attach.")
WXL_API_CLOSE(m2, release_model, Release, none, Model, unloaded,
              "Takes the model off what it hangs on and gives it back; the mod's models go when it unloads too.")
WXL_API(m2, attach_model, Attach, result, (Model model, ptr parent, u32 attachment, u32 flags), generated, generated,
        "Hangs the model on a model at an attachment point; flags 1 attaches to the root where the point is missing, 2 makes it follow the parent's bones.")
WXL_API(m2, detach_model, Detach, none, (Model model), generated, generated,
        "Takes the model off what it hangs on.")
WXL_API(m2, model_parent, Parent, ptr, (Model model), generated, generated,
        "What the model hangs on; nil, \"not_found\" for nothing, which is how a mod tells its model was let go.")
WXL_API(m2, set_geosets, SetGeosets, none, (Model model, u32 first, u32 last, boolean visible), generated, generated,
        "Shows or hides every geoset of the model whose id is in [first, last].")
WXL_API(m2, replace_texture, ReplaceTexture, result, (Model model, u32 type, str path), generated, generated,
        "Replaces the texture the model takes for a texture type (2 an item's skin, 11-13 a creature's) with a file.")
WXL_API(m2, attachment_point, AttachmentPoint, out<vec3>, (cptr model, u32 attachment), generated, generated,
        "Where an attachment point of a loaded model sits in its bind pose, as {x, y, z}.")
WXL_API(m2, attach_to_bone, AttachToBone, result, (Model model, ptr parent, u32 attachment, u32 key_bone, vec3 offset), generated, generated,
        "Hangs the model on one key bone of a model, moved by an offset: an attachment point the parent's file does not have.")

// --- Models of the world and bone watchers (0.1.21): what spell effects and live physics need.
// A script places models of the world as a C++ mod does; the bone watchers run on the client's
// animate threads, where no script runs, so they stay native.

WXL_API_SINCE(m2, create_world_model, (0, 1, 21))
WXL_API(m2, create_world_model, CreateWorldModel, Model, (str path), generated, generated,
        "Makes a model of a file in the world's scene, for this mod: it shows once placed with Place or hung on a unit's model.")
WXL_API(m2, place_model, Place, result, (Model model, placement placement), generated, generated,
        "Puts the model in the world at {position = {x, y, z}, yaw, pitch, roll, scale} (radians; scale 1 when left out), or moves it there; leaving the world takes it out.")
WXL_API(m2, set_model_transform, SetTransform, result, (Model model, placement placement), generated, generated,
        "How the model sits on the point it hangs on: an offset from the point in its own frame, a turn and a scale.")
WXL_API(m2, play_animation, PlayAnimation, result, (Model model, u32 anim_id, f32 speed), generated, generated,
        "Plays an animation (AnimationData id) on the whole model from its start at a speed, 1 normal; kept until it has loaded.")
WXL_API(m2, model_loaded, ModelLoaded, boolean, (ptr model), generated, generated,
        "Whether a model's file has loaded: one of the mod's, or the client's.")
WXL_API(m2, animation_length, AnimationLength, out<u32>, (ptr model, u32 anim_id), generated, generated,
        "How long one play of an animation of a loaded model lasts, in milliseconds; 0 when it has none.")
WXL_API(m2, set_alpha, SetAlpha, none, (Model model, f32 alpha), generated, generated,
        "The model's own alpha, 0 to 1: a fade.")
WXL_API(m2, set_emitting, SetEmitting, none, (Model model, boolean emitting), generated, generated,
        "Whether the model's particles and ribbons make anything new; those already made play out.")
WXL_API(m2, attachment_world, AttachmentWorld, out<vec3>, (ptr model, u32 attachment), generated, generated,
        "Where an attachment point of a loaded model is in the world now, as {x, y, z}.")
WXL_API(m2, ground_height, GroundHeight, out<f32>, (vec3_in at, f32 up, f32 down), generated, generated,
        "The height of the ground under a point: the first surface a ray meets from `up` yards above it to `down` yards below.")
WXL_API(m2, watch_bones, WatchBones, out<u32>, (bones_filter_fn filter, bones_fn fn, ptr user), native, by_hand, "")
WXL_API(m2, unwatch_bones, UnwatchBones, none, (u32 token), native, by_hand, "")
WXL_API(m2, bone_info, BoneInfo, result, (ptr file, u32 index, i16_out parent, vec3_out pivot), native, by_hand, "")

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
