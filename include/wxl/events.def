// SPDX-License-Identifier: MIT
// Copyright (c) 2026 WarcraftXL
//
// The event table: one row per event, and the single source of the event enum, of the C++ hook
// methods and of the event -> args binding.
//
// Include it with WXL_EVENT(family, name, id, args) defined. Expanders ignore the columns they do
// not need.
//
//   family  which C++ script class carries the hook
//   name    the event's name; the C++ method is On<name>, the enum value WXL_EV_<name>
//   id      the ABI. Appended with the next free number, never renumbered, never removed.
//   args    the struct passed to handlers, declared in events.h
//
// Only events every runtime can raise belong here. A hook that exists because of how one client
// happens to be built is published by that runtime as a service of its own, not added below.
//
// Handlers run on the client's main thread, except where a row says it may be raised elsewhere.
//
// Which version of the contract brought which events is written once, in rows of a second shape
// placed among the events:
//
//   WXL_EVENTS_SINCE(major, minor, feature, first)
//
// abi major.minor.feature brought the events from id `first` on. The row sits right above the
// event of id `first`; since ids are appended, every event from that id up to the next such row
// came with that version. A feature that appends events opens them with one of these rows, the
// version abi.h is raised to and the first new id; a feature that appends no event adds none.
// wxl/reflect.hpp reads them (wxl::reflect::Since), so that wxl.lua refuses a script mod's
// subscription to an event newer than the "abi" its manifest asks for, and the host one from a
// binary built against headers that did not have the event; tests/reflect.cpp checks that each
// row sits above its first event and that none is newer than abi.h.

// Two ways to consume it, and nothing to remember:
//
//   define WXL_EVENT(family, name, id, args)       -- every row, family as an argument
//   define WXL_EVENT_<family>(name, id, args)      -- only the families you name
//
// Whatever is left undefined defaults below and is cleaned up at the end, so a runtime that
// serves one family writes one macro and a mod that wants the whole table writes the other.

#if !defined(WXL_EVENT) && !defined(WXL_EVENT_World) && !defined(WXL_EVENT_Render) && \
    !defined(WXL_EVENT_Object) && !defined(WXL_EVENT_Asset) && !defined(WXL_EVENT_Net) && \
    !defined(WXL_EVENT_Lua) && !defined(WXL_EVENT_Combat) && !defined(WXL_EVENT_Player) && \
    !defined(WXL_EVENT_Glue) && !defined(WXL_EVENT_Chat) && !defined(WXL_EVENT_Loot) && \
    !defined(WXL_EVENT_Item) && !defined(WXL_EVENT_Quest) && !defined(WXL_EVENT_Group) && \
    !defined(WXL_EVENT_Social) && !defined(WXL_EVENTS_SINCE)
    #error "define WXL_EVENT(family, name, id, args), a WXL_EVENT_<family> or WXL_EVENTS_SINCE before events.def"
#endif

#ifndef WXL_EVENT
    #define WXL_EVENT(family, name, id, args) WXL_EVENT_##family(name, id, args)
    #define WXL_EVENT_DEFAULTED
#endif
#ifndef WXL_EVENTS_SINCE
    #define WXL_EVENTS_SINCE(major, minor, feature, first)
    #define WXL_EVENTS_SINCE_DEFAULTED
#endif
#ifndef WXL_EVENT_World
    #define WXL_EVENT_World(name, id, args)
    #define WXL_EVENT_World_DEFAULTED
#endif
#ifndef WXL_EVENT_Render
    #define WXL_EVENT_Render(name, id, args)
    #define WXL_EVENT_Render_DEFAULTED
#endif
#ifndef WXL_EVENT_Object
    #define WXL_EVENT_Object(name, id, args)
    #define WXL_EVENT_Object_DEFAULTED
#endif
#ifndef WXL_EVENT_Asset
    #define WXL_EVENT_Asset(name, id, args)
    #define WXL_EVENT_Asset_DEFAULTED
#endif
#ifndef WXL_EVENT_Net
    #define WXL_EVENT_Net(name, id, args)
    #define WXL_EVENT_Net_DEFAULTED
#endif
#ifndef WXL_EVENT_Lua
    #define WXL_EVENT_Lua(name, id, args)
    #define WXL_EVENT_Lua_DEFAULTED
#endif
#ifndef WXL_EVENT_Combat
    #define WXL_EVENT_Combat(name, id, args)
    #define WXL_EVENT_Combat_DEFAULTED
#endif
#ifndef WXL_EVENT_Player
    #define WXL_EVENT_Player(name, id, args)
    #define WXL_EVENT_Player_DEFAULTED
#endif
#ifndef WXL_EVENT_Glue
    #define WXL_EVENT_Glue(name, id, args)
    #define WXL_EVENT_Glue_DEFAULTED
#endif
#ifndef WXL_EVENT_Chat
    #define WXL_EVENT_Chat(name, id, args)
    #define WXL_EVENT_Chat_DEFAULTED
#endif
#ifndef WXL_EVENT_Loot
    #define WXL_EVENT_Loot(name, id, args)
    #define WXL_EVENT_Loot_DEFAULTED
#endif
#ifndef WXL_EVENT_Item
    #define WXL_EVENT_Item(name, id, args)
    #define WXL_EVENT_Item_DEFAULTED
#endif
#ifndef WXL_EVENT_Quest
    #define WXL_EVENT_Quest(name, id, args)
    #define WXL_EVENT_Quest_DEFAULTED
#endif
#ifndef WXL_EVENT_Group
    #define WXL_EVENT_Group(name, id, args)
    #define WXL_EVENT_Group_DEFAULTED
#endif
#ifndef WXL_EVENT_Social
    #define WXL_EVENT_Social(name, id, args)
    #define WXL_EVENT_Social_DEFAULTED
#endif

// --- World: the game's own facts -----------------------------------------------------------

// Everything numbered before the three-part version came with the first contract under it.
WXL_EVENTS_SINCE(0, 1, 5, 0)

/** The logic tick advanced. */
WXL_EVENT(World, Update,        0, wxl_update_args)
/** The world finished loading and the player is in it: after a login and every loading screen
    (a teleport, an instance), once per entry; a /reload is no entry. */
WXL_EVENT(World, WorldEnter,    1, wxl_world_args)
/** The player is leaving the world: a logout, a teleport with a loading screen. Once per exit, the
    map being left still loaded; a /reload is no exit. */
WXL_EVENT(World, WorldLeave,    2, wxl_world_args)
/** A click resolved to a point in the world, and possibly to an object. */
WXL_EVENT(World, WorldClick,    3, wxl_world_click_args)
/** Raw input arrived. A handler may swallow it. */
WXL_EVENT(World, Input,         4, wxl_input_args)
/** A sound is about to play. A handler may suppress it. */
WXL_EVENT(World, SoundPlay,     5, wxl_sound_args)

// --- Render: the slots of a frame --------------------------------------------------------
//
// These carry no device. A mod that needs to draw asks the runtime for its graphics service; what
// the slots guarantee is *when* they run, which is the part every runtime can promise.

/** A frame is starting, before anything is drawn. */
WXL_EVENT(Render, FrameBegin,        6, wxl_frame_args)
/** The frame is drawn and about to be presented. */
WXL_EVENT(Render, FrameEnd,          7, wxl_frame_args)
/** The world pass is about to draw. */
WXL_EVENT(Render, WorldRenderBegin,  8, wxl_frame_args)
/** The world is drawn and the interface is not: the post-process slot. */
WXL_EVENT(Render, WorldRenderEnd,    9, wxl_frame_args)
/** The interface is drawn: the overlay slot, on top of everything. */
WXL_EVENT(Render, UiRenderEnd,      10, wxl_frame_args)
/** Swapchain resources are about to be released; release anything derived from them. */
WXL_EVENT(Render, SwapchainLost,    11, wxl_swapchain_args)
/** The swapchain is back; recreate what was released. */
WXL_EVENT(Render, SwapchainRestored,12, wxl_swapchain_args)

// --- Object: what lives in the world -----------------------------------------------------

/** An object entered the client's view. */
WXL_EVENT(Object, ObjectCreate,     13, wxl_object_args)
/** An object's server-side fields changed: once per object and update packet, after the whole
    packet is applied. An object the packet creates is announced by ObjectCreate instead. */
WXL_EVENT(Object, ObjectUpdate,     14, wxl_object_args)
/** An object is about to leave; it is still resident and its handle still resolves. */
WXL_EVENT(Object, ObjectDestroy,    15, wxl_object_args)
/** The player's target changed. */
WXL_EVENT(Object, TargetChanged,    16, wxl_target_args)
/** A map doodad was placed. */
WXL_EVENT(Object, DoodadSpawn,      17, wxl_doodad_args)
/** A unit's equipment slot was filled or cleared. */
WXL_EVENT(Object, EquipmentChanged, 18, wxl_equipment_args)

// --- Asset: what comes off disk ----------------------------------------------------------

/** A model's bytes were read, before they are parsed. A handler may substitute them. */
WXL_EVENT(Asset, ModelLoad,         19, wxl_model_load_args)
/** A texture was requested by name. Fires on every reference, cached or not. */
WXL_EVENT(Asset, TextureLoad,       20, wxl_texture_load_args)
/** A terrain chunk is being built. */
WXL_EVENT(Asset, TerrainChunkBuild, 21, wxl_terrain_chunk_args)
/** A map object's root was read, before its sub-chunks are walked. */
WXL_EVENT(Asset, MapObjectLoad,     22, wxl_map_object_args)
/** A file is about to be opened by name. A handler may answer with another path. May be raised
    on any thread that opens files. */
WXL_EVENT(Asset, FileOpen,          29, wxl_file_open_args)
/** A file open finished, whether or not it found anything. May be raised on any thread that opens
    files. */
WXL_EVENT(Asset, FileOpened,        30, wxl_file_opened_args)
/** A client database finished loading; its records are readable. */
WXL_EVENT(Asset, ClientDbLoaded,    31, wxl_client_db_args)

// --- Net: what crosses to the server -----------------------------------------------------
//
// The payload is the wire body, after the opcode and before any client parsing. A handler may
// suppress a message in either direction; suppressing an incoming one hides it from the client
// entirely, which is how a mod serves an opcode the client does not know.

/** A message arrived from the server, before the client dispatches it. */
WXL_EVENT(Net, MessageReceived, 23, wxl_message_args)
/** A message is about to go to the server. May be raised on the connection's own thread. */
WXL_EVENT(Net, MessageSent,     24, wxl_message_args)
/** The connection to the world server came up. */
WXL_EVENT(Net, Connected,       25, wxl_connection_args)
/** The connection went away, for any reason. */
WXL_EVENT(Net, Disconnected,    26, wxl_connection_args)

// --- Lua: the script VM ------------------------------------------------------------------
//
// The client runs two script contexts in turn: the login glue and the game. Each is created and
// destroyed more than once in a session, so anything registered on one is registered again on the
// next -- these events are where that happens. A context is announced when its interface comes
// up, after the client's own functions are registered and before its frames load; the client
// also makes contexts it destroys before loading any interface into them (while it starts, and
// between the game and the glue), and those raise neither event.

/** A script context with an interface coming up exists and can be registered on. */
WXL_EVENT(Lua, ScriptVmReady,   27, wxl_script_vm_args)
/** A script context is about to be destroyed. Anything held on it dies with it. */
WXL_EVENT(Lua, ScriptVmClosing, 28, wxl_script_vm_args)

// --- Object, continued -------------------------------------------------------------------

/** A unit died. */
WXL_EVENT(Object, UnitDeath,       32, wxl_unit_args)
/** An aura was applied to or removed from a unit. */
WXL_EVENT(Object, UnitAuraChanged, 33, wxl_unit_aura_args)

// Casts, as the server tells the client about them (any caster in view) and as the local player
// asks for them. The two requests carry an answer a handler writes to refuse the request.

/** A unit in view started a cast: the server's SMSG_SPELL_START, before the client parses it. */
WXL_EVENT(Object, SpellCastStart,       34, wxl_spell_cast_args)
/** A cast went off: SMSG_SPELL_GO, with the hits and misses counted. */
WXL_EVENT(Object, SpellCastGo,          35, wxl_spell_cast_args)
/** A cast of the local player's failed, with the client's reason; the client's own refusals too. */
WXL_EVENT(Object, SpellCastFailed,      36, wxl_spell_fail_args)
/** A cast in progress was stopped by the server: SMSG_SPELL_FAILURE, for any caster in view. */
WXL_EVENT(Object, SpellCastInterrupted, 37, wxl_spell_fail_args)
/** The local player asks to cast a spell. A handler may refuse it. */
WXL_EVENT(Object, SpellCastRequest,     38, wxl_spell_request_args)
/** The local player asks to use an item. A handler may refuse it. */
WXL_EVENT(Object, ItemUseRequest,       39, wxl_item_use_args)

// --- Lua, continued ----------------------------------------------------------------------

/** The client fires an event to its interface, with the values it passes along. */
WXL_EVENT(Lua, UiEvent,     40, wxl_ui_event_args)
/** The interface's Lua raised an error, before the client's error handler sees it. */
WXL_EVENT(Lua, ScriptError, 41, wxl_script_error_args)

// --- Object, continued: casts in progress, cooldowns, the player's own cancel ------------

/** A unit in view started channelling: MSG_CHANNEL_START, with the channel's length. */
WXL_EVENT(Object, SpellChannelStart,    42, wxl_spell_progress_args)
/** A channel in progress was updated: MSG_CHANNEL_UPDATE with time left. */
WXL_EVENT(Object, SpellChannelUpdate,   43, wxl_spell_progress_args)
/** A channel ended: MSG_CHANNEL_UPDATE with no time left. */
WXL_EVENT(Object, SpellChannelStop,     44, wxl_spell_progress_args)
/** A cast already running when its caster came into view: SMSG_UNIT_SPELLCAST_START. */
WXL_EVENT(Object, SpellCastResume,      45, wxl_spell_progress_args)
/** A cast in progress was pushed back: SMSG_SPELL_DELAYED, for any caster in view. */
WXL_EVENT(Object, SpellCastDelayed,     46, wxl_spell_delay_args)
/** A cooldown was put on a spell or an item: SMSG_SPELL_COOLDOWN, one per spell, or SMSG_ITEM_COOLDOWN. */
WXL_EVENT(Object, SpellCooldown,        47, wxl_spell_cooldown_args)
/** A cooldown was released, cleared or shifted: SMSG_COOLDOWN_EVENT, SMSG_CLEAR_COOLDOWN, SMSG_MODIFY_COOLDOWN. */
WXL_EVENT(Object, SpellCooldownChanged, 48, wxl_spell_cooldown_change_args)
/** The local player cancels a cast of its own, before the client tells the server. */
WXL_EVENT(Object, SpellCastCancel,      49, wxl_spell_cancel_args)

// --- Combat: what the server reports of fights -------------------------------------------
//
// Read off the server's messages before the client parses them, for any unit in view. The
// amounts are the server's; the client adds nothing to them.

/** A unit started auto-attacking another: SMSG_ATTACKSTART. */
WXL_EVENT(Combat, CombatAttackStart, 50, wxl_combat_attack_args)
/** A unit stopped auto-attacking: SMSG_ATTACKSTOP, or SMSG_COMBAT_EVENT_FAILED, which the client treats the same. */
WXL_EVENT(Combat, CombatAttackStop,  51, wxl_combat_attack_args)
/** Damage landed: a melee round, a spell, a periodic tick or the environment. */
WXL_EVENT(Combat, CombatDamage,      52, wxl_combat_damage_args)
/** A heal landed, direct or a periodic tick. */
WXL_EVENT(Combat, CombatHeal,        53, wxl_combat_heal_args)
/** An attack did not land: a spell on one of its targets, or a melee round. */
WXL_EVENT(Combat, CombatMiss,        54, wxl_combat_miss_args)

// --- World, continued: where the player is, what the mouse is over, the console -----------

WXL_EVENTS_SINCE(0, 1, 6, 55)

/** The player's zone, subzone or indoor state changed, as the client announces it to its interface. */
WXL_EVENT(World, ZoneChanged,      55, wxl_zone_args)
/** The object under the mouse changed: a unit, a game object, or nothing. */
WXL_EVENT(World, MouseoverChanged, 56, wxl_mouseover_args)
/** A console variable's value changed, by whoever set it. */
WXL_EVENT(World, CVarChanged,      57, wxl_cvar_args)

// --- Player: what the local player does and is told ---------------------------------------

/** The local player's own movement started: a move, strafe, turn, pitch, jump, ascent or descent, as it is sent to the server. */
WXL_EVENT(Player, PlayerMoveStart,    58, wxl_player_move_args)
/** It stopped: the matching stop, or the landing of a fall. */
WXL_EVENT(Player, PlayerMoveStop,     59, wxl_player_move_args)
/** The local player gained a level: SMSG_LEVELUP_INFO, with what the level added. */
WXL_EVENT(Player, PlayerLevelUp,      60, wxl_level_up_args)
/** The local player gained experience: SMSG_LOG_XPGAIN. */
WXL_EVENT(Player, PlayerXpGain,       61, wxl_xp_gain_args)
/** The local player's money changed, with the amounts before and after. */
WXL_EVENT(Player, PlayerMoneyChanged, 62, wxl_money_args)

// --- Glue: the login screens ---------------------------------------------------------------

/** The glue moved to another screen: "login", "charselect", "charcreate", "realmwizard", ... */
WXL_EVENT(Glue, GlueScreenChanged,  63, wxl_glue_screen_args)
/** The character list arrived: SMSG_CHAR_ENUM, with its count. One GlueCharacter per entry follows. */
WXL_EVENT(Glue, GlueCharacterList,  64, wxl_character_list_args)
/** One character of the list, in order. */
WXL_EVENT(Glue, GlueCharacter,      65, wxl_character_args)
/** The realm list arrived from the logon server, with its count. One GlueRealm per entry follows.
    May be raised on the logon connection's thread. */
WXL_EVENT(Glue, GlueRealmList,      66, wxl_realm_list_args)
/** One realm of the list, in order. May be raised on the logon connection's thread. */
WXL_EVENT(Glue, GlueRealm,          67, wxl_realm_args)
/** The world server answered the login: SMSG_AUTH_RESPONSE, with the result and the queue. */
WXL_EVENT(Glue, GlueAuthResult,     68, wxl_auth_result_args)
/** The client asks to enter the world with a character: CMSG_PLAYER_LOGIN, before it is sent. */
WXL_EVENT(Glue, GlueEnterWorld,     69, wxl_enter_world_args)

// --- Chat: what is said ---------------------------------------------------------------------

/** A chat message of the server (SMSG_MESSAGECHAT, SMSG_GM_MESSAGECHAT) became a line the client shows, as it shows it; nothing for one it drops. */
WXL_EVENT(Chat, ChatMessage, 70, wxl_chat_args)
/** The local player sends a chat or addon message from the interface. A handler may suppress it. */
WXL_EVENT(Chat, ChatSend,    71, wxl_chat_send_args)

// --- Combat, continued ----------------------------------------------------------------------

/** Power was given or drained: SMSG_SPELLENERGIZELOG, or an energize or drain tick of SMSG_PERIODICAURALOG. */
WXL_EVENT(Combat, CombatEnergize, 72, wxl_combat_energize_args)

// --- Chat, continued ------------------------------------------------------------------------

WXL_EVENTS_SINCE(0, 1, 7, 73)

/** An addon message of the server is delivered to the interface as CHAT_MSG_ADDON, with its prefix, text and sender. */
WXL_EVENT(Chat, ChatAddonMessage, 73, wxl_chat_addon_args)

// --- Object, continued ----------------------------------------------------------------------

WXL_EVENTS_SINCE(0, 1, 9, 74)

/** A descriptor field watch_field asked for changed on an object, as an update of the server applied it. */
WXL_EVENT(Object, ObjectFieldChanged, 74, wxl_object_field_args)

// --- Asset and World, continued: where the memory goes ----------------------------------------

WXL_EVENTS_SINCE(0, 1, 11, 75)

/** The client mounted an archive, with its tables read. */
WXL_EVENT(Asset, ArchiveMounted,   75, wxl_archive_args)
/** The client is about to close an archive it mounted. */
WXL_EVENT(Asset, ArchiveUnmounted, 76, wxl_archive_args)
/** The largest free block of the address space fell under the threshold a mod watches (wxl.footprint). */
WXL_EVENT(World, MemoryPressure,   77, wxl_memory_pressure_args)

// --- Gameplay: auras, loot, items, quests, groups and the people around ---------------------
//
// Raised where the client commits what the server told it: the aura slot it fills, the loot
// window it opens, the inventory slot it updates, the quest log entry it writes. A message the
// client only reports (a roll, a reward, an invitation) is read before the client parses it.

WXL_EVENTS_SINCE(0, 1, 17, 78)

/** An aura was put in one of a unit's aura slots. */
WXL_EVENT(Object, UnitAuraApplied,   78, wxl_aura_args)
/** An aura left a unit's aura slot, with what it was. */
WXL_EVENT(Object, UnitAuraRemoved,   79, wxl_aura_args)
/** An aura still on a unit gained or lost stacks, or had its duration renewed. */
WXL_EVENT(Object, UnitAuraRefreshed, 80, wxl_aura_args)
/** A unit mounted, dismounted or changed mounts. */
WXL_EVENT(Object, UnitMountChanged,  81, wxl_mount_args)

/** The loot window opened on something. One LootSlot per item follows. */
WXL_EVENT(Loot, LootOpened,      82, wxl_loot_args)
/** One item of the loot window that just opened, in the window's order. */
WXL_EVENT(Loot, LootSlot,        83, wxl_loot_slot_args)
/** An item left the loot window: taken by the player or by someone of its group. */
WXL_EVENT(Loot, LootSlotCleared, 84, wxl_loot_slot_args)
/** The loot window closed. */
WXL_EVENT(Loot, LootClosed,      85, wxl_loot_args)
/** The local player received its share of looted money. */
WXL_EVENT(Loot, LootMoney,       86, wxl_loot_money_args)
/** A roll started on an item of a group's loot. */
WXL_EVENT(Loot, LootRollStart,   87, wxl_loot_roll_start_args)
/** A member of the group chose on a roll. */
WXL_EVENT(Loot, LootRoll,        88, wxl_loot_roll_args)
/** A roll was won. */
WXL_EVENT(Loot, LootRollWon,     89, wxl_loot_roll_args)
/** Everyone passed on a roll. */
WXL_EVENT(Loot, LootAllPassed,   90, wxl_loot_roll_args)

/** An item was looted, given or made for the local player or a member of its group. */
WXL_EVENT(Item, ItemPushed,            91, wxl_item_push_args)
/** A slot of the local player's inventory or of one of its bags got another item, or none. */
WXL_EVENT(Item, InventorySlotChanged,  92, wxl_inventory_slot_args)
/** An item's durability changed. */
WXL_EVENT(Item, ItemDurabilityChanged, 93, wxl_item_durability_args)
/** An item's stack count changed. */
WXL_EVENT(Item, ItemStackChanged,      94, wxl_item_stack_args)
/** The server refused an inventory change, with its reason. */
WXL_EVENT(Item, InventoryError,        95, wxl_inventory_error_args)

/** A quest entered the local player's quest log. */
WXL_EVENT(Quest, QuestAccepted,         96, wxl_quest_args)
/** A quest left the quest log: abandoned, turned in or removed by the server. */
WXL_EVENT(Quest, QuestRemoved,          97, wxl_quest_args)
/** The count of one of a quest's objectives moved. */
WXL_EVENT(Quest, QuestObjectiveChanged, 98, wxl_quest_objective_args)
/** Every objective of a quest of the log is done. */
WXL_EVENT(Quest, QuestCompleted,        99, wxl_quest_args)
/** A quest of the log failed. */
WXL_EVENT(Quest, QuestFailed,          100, wxl_quest_args)
/** A quest was turned in, with its rewards. */
WXL_EVENT(Quest, QuestTurnedIn,        101, wxl_quest_reward_args)
/** A quest giver greets the player with the quests it has. */
WXL_EVENT(Quest, QuestGiverGreeting,   102, wxl_quest_giver_args)
/** A quest giver shows a quest's details, to accept it. */
WXL_EVENT(Quest, QuestGiverDetail,     103, wxl_quest_giver_args)
/** A quest giver shows what a quest still asks for. */
WXL_EVENT(Quest, QuestGiverProgress,   104, wxl_quest_giver_args)
/** A quest giver shows a quest's reward, to turn it in. */
WXL_EVENT(Quest, QuestGiverReward,     105, wxl_quest_giver_args)

/** The local player is invited to a group. A handler may accept or decline it. */
WXL_EVENT(Group, GroupInvite,            106, wxl_group_invite_args)
/** The server listed the local player's group. One GroupMember per other member follows. */
WXL_EVENT(Group, GroupUpdated,           107, wxl_group_args)
/** One other member of the group, in the list's order. */
WXL_EVENT(Group, GroupMember,            108, wxl_group_member_args)
/** The local player is no longer in a group. */
WXL_EVENT(Group, GroupLeft,              109, wxl_group_left_args)
/** The group's loot method, master looter or threshold changed. */
WXL_EVENT(Group, GroupLootMethodChanged, 110, wxl_group_loot_args)
/** A ready check started. */
WXL_EVENT(Group, ReadyCheck,             111, wxl_ready_check_args)
/** A member answered the ready check. */
WXL_EVENT(Group, ReadyCheckResponse,     112, wxl_ready_check_response_args)
/** The ready check is over. */
WXL_EVENT(Group, ReadyCheckFinished,     113, wxl_ready_check_end_args)

/** The local player is challenged to a duel. A handler may accept or decline it. */
WXL_EVENT(Social, DuelRequested,    114, wxl_duel_request_args)
/** The local player's duel counts down to its start. */
WXL_EVENT(Social, DuelCountdown,    115, wxl_duel_countdown_args)
/** A duel in view was won. */
WXL_EVENT(Social, DuelWon,          116, wxl_duel_won_args)
/** The local player's duel is over, fought or cancelled. */
WXL_EVENT(Social, DuelFinished,     117, wxl_duel_finished_args)
/** A trade moved a step: proposed, opened, accepted, completed, cancelled, refused. */
WXL_EVENT(Social, TradeStatus,      118, wxl_trade_args)
/** A unit in view played an emote's animation. */
WXL_EVENT(Social, Emote,            119, wxl_emote_args)
/** A player's text emote reached the local player. */
WXL_EVENT(Social, TextEmote,        120, wxl_text_emote_args)
/** Someone offers to resurrect the local player. A handler may accept or decline it. */
WXL_EVENT(Social, ResurrectRequest, 121, wxl_resurrect_request_args)
/** A window opened on someone the player talks to: a vendor, a trainer, a banker, a quest giver, ... */
WXL_EVENT(Social, WindowOpened,     122, wxl_window_args)
/** That window closed. */
WXL_EVENT(Social, WindowClosed,     123, wxl_window_args)

/** The local player died. */
WXL_EVENT(Player, PlayerDied,         124, wxl_unit_args)
/** The local player released its spirit and is a ghost. */
WXL_EVENT(Player, PlayerReleased,     125, wxl_unit_args)
/** The local player is alive again, after death or as a ghost. */
WXL_EVENT(Player, PlayerResurrected,  126, wxl_unit_args)
/** The local player's standing with a faction changed. */
WXL_EVENT(Player, ReputationChanged,  127, wxl_reputation_args)
/** A player in view, or the local player, earned an achievement. */
WXL_EVENT(Player, AchievementEarned,  128, wxl_achievement_args)

// --- Asset, continued: the engine's own loads (the asset pipeline) --------------------------

WXL_EVENTS_SINCE(0, 1, 19, 129)

/** A terrain tile's file was read, before its chunks are walked. */
WXL_EVENT(Asset, TerrainTileLoad,    129, wxl_terrain_tile_args)
/** A map object's group file was read, before its chunks are walked. */
WXL_EVENT(Asset, MapObjectGroupLoad, 130, wxl_map_object_group_args)
/** A model's skin profile (its .skin file) was read, before it is parsed. */
WXL_EVENT(Asset, SkinProfileLoad,    131, wxl_skin_profile_args)
/** A texture file is about to be decoded: what its header says. */
WXL_EVENT(Asset, TextureDecode,      132, wxl_texture_decode_args)
/** The graphics device is loading a shader program by name. */
WXL_EVENT(Asset, ShaderLoad,         133, wxl_shader_load_args)
/** The sound engine is opening a sound file to play it. Never raised while the client's sound is off
    (`Sound_EnableAllSound` 0): the client then loads no sound, though SoundPlay is still raised. */
WXL_EVENT(Asset, SoundFileLoad,      134, wxl_sound_file_args)

// --- Models: the loader's stages, appearances and drawn batches ------------------------------

WXL_EVENTS_SINCE(0, 1, 20, 135)

/** A model file was parsed, before the client chooses its skin profile and makes its textures. */
WXL_EVENT(Asset, ModelParsed,       135, wxl_model_parsed_args)
/** A model's skin profile was parsed, before the client sizes its draw state from it. */
WXL_EVENT(Asset, SkinProfileParsed, 136, wxl_skin_profile_parsed_args)
/** An external sequence file of a model was read, before it is parsed against the model. */
WXL_EVENT(Asset, ModelSequenceLoad, 137, wxl_model_sequence_args)
/** A character appearance put an item display on, is taking one off, or is going away. */
WXL_EVENT(Object, AppearanceChanged, 138, wxl_appearance_args)
/** The client's Direct3D 9 device has just drawn one batch of a model. */
WXL_EVENT(Render, ModelBatchDrawn,  139, wxl_model_batch_args)

// --- Asset, continued: names no layer has ----------------------------------------------------

WXL_EVENTS_SINCE(0, 1, 22, 140)

/** The client looked for a file -- to open it or to know whether it exists -- and no layer has it:
    not the disk, not an archive, not a folder of the search path, no provider, no served bytes.
    Raised on whichever thread asked, often a loader thread; once per ask, so one name may come
    more than once. `pending` says a provider answered "not yet" for it. A mod's own wxl.storage
    calls raise nothing. */
WXL_EVENT(Asset, FileMissing,       140, wxl_file_missing_args)

// --- The mouse and the camera ----------------------------------------------------------------

WXL_EVENTS_SINCE(0, 1, 23, 141)

/** The mouse moved, in the device's own counts, as Windows' raw input reports them: raised for
    every report while a mod listens, whether the pointer moves or is held by wxl.input. */
WXL_EVENT(World, MouseMotion,      141, wxl_mouse_motion_args)
/** The mouse wheel turned. A handler may keep the turn from the game. */
WXL_EVENT(World, MouseWheel,       142, wxl_mouse_wheel_args)
/** The client has placed the world camera for this frame, before anything is drawn from it:
    where a mod places it instead, through wxl.camera. */
WXL_EVENT(Render, CameraUpdate,    143, wxl_frame_args)

