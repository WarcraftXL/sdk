WXL_ENUM_VALUE(wxl_mouse_button, WXL_MOUSE_RIGHT,  1, right)
WXL_ENUM_VALUE(wxl_mouse_button, WXL_MOUSE_MIDDLE, 2, middle)
WXL_ENUM_END(wxl_mouse_button)

/// What happened to a cooldown the client was holding.
WXL_ENUM(wxl_cooldown_change)
