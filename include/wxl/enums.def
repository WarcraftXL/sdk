/// How a texture file stores its pixels: the BLP2 header's encoding byte.
WXL_ENUM(wxl_texture_encoding)
WXL_ENUM_VALUE(wxl_texture_encoding, WXL_TEXTURE_JPEG,    0, jpeg)    ///< legacy; this client does not decode it
WXL_ENUM_VALUE(wxl_texture_encoding, WXL_TEXTURE_PALETTE, 1, palette) ///< 256 colours and an alpha plane
WXL_ENUM_VALUE(wxl_texture_encoding, WXL_TEXTURE_DXT,     2, dxt)     ///< block-compressed: DXT1, 3 or 5
WXL_ENUM_VALUE(wxl_texture_encoding, WXL_TEXTURE_RAW,     3, raw)     ///< 32-bit pixels as they are
WXL_ENUM_END(wxl_texture_encoding)

