WXL_ENUM_VALUE(wxl_cooldown_change, WXL_COOLDOWN_CLEARED, 1, cleared) ///< it is gone
WXL_ENUM_VALUE(wxl_cooldown_change, WXL_COOLDOWN_SHIFTED, 2, shifted) ///< it moved, by the delay the event carries
WXL_ENUM_END(wxl_cooldown_change)

