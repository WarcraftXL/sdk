                "Its beast family, a CreatureFamily.dbc id; 0 for none.")
WXL_OBJECT_READ(Units, unit_classification, UnitClassification, uint32_t, client, Classification, wxl_classification,
                "Its rank: normal, elite, rare, rare elite, world boss.")
WXL_OBJECT_READ_AT(Units, unit_knows_spell, UnitKnowsSpell, wxl_bool, client, KnowsSpell, bool, uint32_t, uint32_t,
                   "Whether it knows a spell: the active player's spell book or its pet's; false for any other unit.")

// Units: movement.
WXL_OBJECT_READ(Units, unit_movement_flags, UnitMovementFlags, uint32_t, field, MovementFlags, uint32_t,
                "The flags of its movement: forward 0x1, backward 0x2, ..., falling 0x1000, flying 0x2000000.")
WXL_OBJECT_READ_AT(Units, unit_speed, UnitSpeed, float, client, Speed, float, uint32_t, wxl_move_type,
                   "One of its speeds, in yards a second: walk, run, swim, flight, ...; the turn and pitch rates in radians a second.")
WXL_OBJECT_READ(Units, unit_is_swimming, UnitIsSwimming, wxl_bool, client, IsSwimming, bool,
                "Whether it swims, as the client's IsSwimming reads it.")
WXL_OBJECT_READ(Units, unit_is_flying, UnitIsFlying, wxl_bool, shared, IsFlying, bool,
                "Whether it flies, as the client's IsFlying reads it.")
WXL_OBJECT_READ(Units, unit_is_falling, UnitIsFalling, wxl_bool, shared, IsFalling, bool,
                "Whether it is falling, as the client's IsFalling reads it.")

