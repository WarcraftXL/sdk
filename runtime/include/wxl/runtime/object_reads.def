WXL_OBJECT_READ(Items, item_duration, ItemDuration, uint32_t, field, Duration, uint32_t,
                "Seconds left before it expires; 0 when it does not.")
WXL_OBJECT_READ(Items, item_flags, ItemFlags, uint32_t, field, Flags, uint32_t,
                "ITEM_FIELD_FLAGS as the server sends it: soulbound 0x1, ...")
WXL_OBJECT_READ(Items, item_durability, ItemDurability, uint32_t, field, Durability, uint32_t,
                "Its durability now.")
WXL_OBJECT_READ(Items, item_max_durability, ItemMaxDurability, uint32_t, field, MaxDurability, uint32_t,
