// --- Corpses -------------------------------------------------------------------------------

WXL_OBJECT_READ(Corpses, corpse_owner, CorpseOwner, wxl_guid, field, OwnerGuid, wxl_guid,
                "The player it belongs to.")
WXL_OBJECT_READ(Corpses, corpse_party, CorpseParty, wxl_guid, field, PartyGuid, wxl_guid,
                "The party the owner was in when they died, or 0.")
WXL_OBJECT_READ(Corpses, corpse_display_id, CorpseDisplayId, uint32_t, field, DisplayId, uint32_t,
