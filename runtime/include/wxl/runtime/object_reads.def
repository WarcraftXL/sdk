// --- the typed API ---------------------------------------------------------------------------

WXL_OBJECT_SINCE(0, 1, 18)

// Any object.
WXL_OBJECT_READ(Any, is_active_player, IsActivePlayer, wxl_bool, shared, IsActivePlayer, bool,
                "Whether it is the unit the client controls.")
WXL_OBJECT_READ_AT(Any, distance, Distance, float, shared, Distance, float, wxl_handle, const Object&,
                   "Yards from it to another object, centre to centre; invalid when either has no place in the world.")
WXL_OBJECT_READ_AT(Any, distance_to, DistanceTo, float, shared, DistanceTo, float, wxl_vec3, wxl_vec3,
                   "Yards from it to a point; invalid for an object with no place in the world.")

// Units: who they face, what they do.
WXL_OBJECT_READ(Units, unit_target_guid, UnitTargetGuid, wxl_guid, client, TargetGuid, wxl_guid,
                "What it targets, as a guid, whether that is in view or not; 0 for nothing.")
WXL_OBJECT_READ(Units, unit_reaction, UnitReaction, uint32_t, client, Reaction, wxl_reaction,
                "How it stands towards the active player, by the client's own reckoning: the colour of its name.")
WXL_OBJECT_READ_AT(Units, unit_reaction_to, UnitReactionTo, uint32_t, client, ReactionTo, wxl_reaction, wxl_handle, const Object&,
                   "How it stands towards another unit, by the client's own reckoning.")
WXL_OBJECT_READ(Units, unit_is_dead, UnitIsDead, wxl_bool, shared, IsDead, bool,
                "Whether it is dead: no health left, or marked dead by the server.")
WXL_OBJECT_READ(Units, unit_in_combat, UnitInCombat, wxl_bool, shared, InCombat, bool,
                "Whether it is in combat, as the client's UnitAffectingCombat reads it.")
WXL_OBJECT_READ(Units, unit_is_pvp, UnitIsPvp, wxl_bool, shared, IsPvp, bool,
                "Whether it is flagged for player-versus-player combat.")
WXL_OBJECT_READ(Units, unit_is_tapped, UnitIsTapped, wxl_bool, shared, IsTapped, bool,
                "Whether someone has tapped it: its kill and loot are theirs.")
WXL_OBJECT_READ(Units, unit_is_tapped_by_player, UnitIsTappedByPlayer, wxl_bool, shared, IsTappedByPlayer, bool,
                "Whether the active player, or their group, has tapped it.")
WXL_OBJECT_READ(Units, unit_is_lootable, UnitIsLootable, wxl_bool, shared, IsLootable, bool,
                "Whether it has loot for the active player.")
WXL_OBJECT_READ(Units, unit_is_skinnable, UnitIsSkinnable, wxl_bool, shared, IsSkinnable, bool,
                "Whether its corpse can be skinned.")
WXL_OBJECT_READ(Units, unit_stand_state, UnitStandState, uint32_t, shared, StandState, wxl_stand_state,
                "How it stands: standing, sitting, sleeping, kneeling, ...")
WXL_OBJECT_READ(Units, unit_is_sitting, UnitIsSitting, wxl_bool, shared, IsSitting, bool,
                "Whether it sits, on the ground or in a chair.")
WXL_OBJECT_READ(Units, unit_is_stealthed, UnitIsStealthed, wxl_bool, shared, IsStealthed, bool,
                "Whether it is stealthed, as the client's IsStealthed reads it.")
WXL_OBJECT_READ(Units, unit_is_mounted, UnitIsMounted, wxl_bool, client, IsMounted, bool,
                "Whether it rides a mount, as the client's IsMounted reads it.")

// Units: the cast and the channel the client shows.
WXL_OBJECT_READ(Units, unit_casting_spell_id, UnitCastingSpellId, uint32_t, field, CastingSpellId, uint32_t,
                "The spell it casts now; 0 for none.")
WXL_OBJECT_READ(Units, unit_cast_start, UnitCastStart, uint32_t, field, CastStart, uint32_t,
                "When the cast began, in milliseconds on the client's clock (the client's GetTime() * 1000).")
WXL_OBJECT_READ(Units, unit_cast_end, UnitCastEnd, uint32_t, field, CastEnd, uint32_t,
                "When the cast ends, on the same clock.")
WXL_OBJECT_READ(Units, unit_is_casting, UnitIsCasting, wxl_bool, client, IsCasting, bool,
                "Whether it is casting, its cast not yet over, as the client's UnitCastingInfo reads it.")
WXL_OBJECT_READ(Units, unit_channel_spell_id, UnitChannelSpellId, uint32_t, field, ChannelSpellId, uint32_t,
                "The spell it channels now; 0 for none.")
WXL_OBJECT_READ(Units, unit_channel_start, UnitChannelStart, uint32_t, field, ChannelStart, uint32_t,
                "When the channel began, on the client's clock.")
WXL_OBJECT_READ(Units, unit_channel_end, UnitChannelEnd, uint32_t, field, ChannelEnd, uint32_t,
                "When the channel ends, on the client's clock.")
WXL_OBJECT_READ(Units, unit_is_channeling, UnitIsChanneling, wxl_bool, client, IsChanneling, bool,
                "Whether it is channeling, its channel not yet over.")

// Units: auras.
WXL_OBJECT_READ(Units, unit_aura_count, UnitAuraCount, uint32_t, client, AuraCount, uint32_t,
                "How many auras the client holds on it, buffs and debuffs alike.")
WXL_OBJECT_READ_AT(Units, unit_aura, UnitAura, wxl_aura, client, Aura, wxl_aura, uint32_t, uint32_t,
                   "The aura in a slot, 0 to AuraCount - 1: its spell, caster, stacks, duration, expiration and flags.")
WXL_OBJECT_READ_AT(Units, unit_has_aura, UnitHasAura, wxl_bool, shared, HasAura, bool, uint32_t, uint32_t,
                   "Whether an aura of a spell is on it.")

// Units: what they are.
WXL_OBJECT_READ(Units, unit_creature_type, UnitCreatureType, uint32_t, client, CreatureType, wxl_creature_type,
                "What kind of creature it is, as the client works it out: beast, humanoid, undead, ...")
