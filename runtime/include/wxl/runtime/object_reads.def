                "Its class, an ItemClass.dbc id: weapon 2, armor 4, ...")
WXL_OBJECT_READ(Items, item_subclass, ItemSubclass, uint32_t, cache, Subclass, uint32_t,
                "Its subclass within the class: a sword, a cloth robe, ...")
WXL_OBJECT_READ(Items, item_inventory_type, ItemInventoryType, uint32_t, cache, InventoryType, uint32_t,
                "Where it is worn: head 1, neck 2, ...; 0 for an item that is not worn.")
WXL_OBJECT_READ(Items, item_max_stack, ItemMaxStack, uint32_t, cache, MaxStack, uint32_t,
                "How many a stack of it holds at most.")
WXL_OBJECT_READ(Items, item_sell_price, ItemSellPrice, uint32_t, cache, SellPrice, uint32_t,
                "What a vendor pays for one, in copper.")

// Containers.
WXL_OBJECT_READ_AT(Containers, container_slot_item, ContainerSlotItem, wxl_handle, shared, SlotItem, Item, uint32_t, uint32_t,
                   "The item in a slot of the bag; none for an empty one, invalid past NumSlots.")

WXL_OBJECT_SINCE(0, 1, 24)

