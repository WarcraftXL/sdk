// SPDX-License-Identifier: MIT
// Copyright (c) 2026 WarcraftXL
//
// The reads behind wxl.object: one row per getter of wxl_object_api that reads one value of an
// object, in member order. The getters that resolve handles or walk the table (valid, guid,
// type, from_guid, local_player, name, unit_target, enumerate, positions, the descriptor fields)
// are written by hand in object_service.cpp.
//
// Every runtime and every facade is made from these rows: the ObjectBinding virtual a runtime
// writes, the service's member with its kind check, the C++ method of the facade class
// (wxl/objects/generated/, written by wxl-object-members), the Lua method of the object
// userdata, the editor definitions and the guides' tables of members.
//
//   WXL_OBJECT_SINCE(major, minor, feature)
//       right above the first row appended with that version of the contract: that row and
//       the ones below it came with it, until the next such row. A Lua mod whose mod.json asks
//       for an older abi cannot use them. The rows above the first came with 0.1.5.
//
//   WXL_OBJECT_READ(kinds, member, Method, type, source, Cxx, cxx, doc)
//   WXL_OBJECT_READ_AT(kinds, member, Method, type, source, Cxx, cxx, Arg, arg, doc)
//
//   kinds   the objects the getter accepts: Any, Units, Players, Items, Containers,
//           GameObjects, Dynamics or Corpses; Active is the player the client controls, whose
//           own fields (money, experience, inventory, skills) the client keeps for no other.
//           Any other live handle answers WXL_E_INVALID.
//   member  the wxl_object_api member the getter is published as.
//   Method  the read behind it: bool Method(void* object, type& out) const, or
//           bool Method(void* object, Arg arg, type& out) const for READ_AT.
//   type    what the getter writes: uint32_t, int32_t, float, wxl_guid, wxl_vec3, wxl_bool, a
//           wxl_handle (an object, resolved in view), or a struct of object.h.
//   source  who answers it:
//             field   the runtime's binding fact of the same name as `member`, read as is (core
//                     needs nothing more);
//             client  a runtime's ObjectBinding virtual, written for each client;
//             cache   the same, from one of the client's caches: false means the client has not
//                     received the record yet, which the getter answers as WXL_E_FAILED;
//             shared  the shared runtime itself (object_reads.cpp), from the descriptor block
//                     and the other reads: the same code on every runtime.
//   Cxx     the C++ facade's method.
//   cxx     what it answers: `type` itself, bool for a wxl_bool, an enumeration of enums.def
//           (Lua sees its name), a C++ enumeration of the facade (Lua sees the number), or a
//           facade class for a wxl_handle.
//   Arg     the C type of the argument: uint32_t, wxl_handle or wxl_vec3.
//   arg     its C++ type: the same, an enumeration (Lua takes its name or its number), or
//           `const Object&` for a wxl_handle.
//   doc     what it answers, in a line, for the facade, the editor definitions and the guides.
//
// Include with WXL_OBJECT_READ_AT and WXL_OBJECT_READ defined; WXL_OBJECT_SINCE defaults to
// nothing.

#ifndef WXL_OBJECT_READ
#error "define WXL_OBJECT_READ(kinds, member, Method, type, source, Cxx, cxx, doc) before including object_reads.def"
#endif
#ifndef WXL_OBJECT_READ_AT
#error "define WXL_OBJECT_READ_AT(kinds, member, Method, type, source, Cxx, cxx, Arg, arg, doc) before including object_reads.def"
#endif
#ifndef WXL_OBJECT_SINCE
    #define WXL_OBJECT_SINCE(major, minor, feature)
    #define WXL_OBJECT_SINCE_DEFAULTED
#endif

// --- Any object ----------------------------------------------------------------------------

WXL_OBJECT_READ(Any, position, Position, wxl_vec3, client, Position, wxl_vec3,
                "Where it stands in the world, in yards; an item has no place.")
WXL_OBJECT_READ(Any, facing, Facing, float, client, Facing, float,
                "The way it faces, in radians.")
WXL_OBJECT_READ(Any, entry, Entry, uint32_t, client, Entry, uint32_t,
                "The server's template id: a creature, item or game-object entry; 0 for a player.")
WXL_OBJECT_READ(Any, scale, Scale, float, client, Scale, float,
                "Its size, 1 being the model's own.")

// --- Units and players ---------------------------------------------------------------------

WXL_OBJECT_READ(Units, unit_health, UnitHealth, int32_t, field, Health, int32_t,
                "Its health; 0 or less is a dead unit, as the client reads it.")
WXL_OBJECT_READ(Units, unit_max_health, UnitMaxHealth, uint32_t, field, MaxHealth, uint32_t,
                "Its maximum health.")
WXL_OBJECT_READ(Units, unit_level, UnitLevel, uint32_t, field, Level, uint32_t,
                "Its level.")
WXL_OBJECT_READ_AT(Units, unit_power, UnitPower, uint32_t, client, PowerValue, uint32_t, uint32_t, Power,
                   "Its power of a type (0 mana, 1 rage, 2 focus, 3 energy, 4 happiness, 5 runes, 6 runic power).")
WXL_OBJECT_READ_AT(Units, unit_max_power, UnitMaxPower, uint32_t, client, MaxPowerValue, uint32_t, uint32_t, Power,
                   "Its maximum power of a type.")
WXL_OBJECT_READ(Units, unit_power_type, UnitPowerType, uint32_t, client, PowerType, Power,
                "The type of power it runs on, as PowerValue takes it.")
WXL_OBJECT_READ(Units, unit_race, UnitRace, uint32_t, client, Race, uint32_t,
                "Its race, as ChrRaces.dbc numbers it.")
WXL_OBJECT_READ(Units, unit_class, UnitClass, uint32_t, client, Class, uint32_t,
                "Its class, as ChrClasses.dbc numbers it.")
WXL_OBJECT_READ(Units, unit_sex, UnitSex, uint32_t, client, Sex, uint32_t,
                "0 male, 1 female, 2 none.")
WXL_OBJECT_READ(Units, unit_display_id, UnitDisplayId, uint32_t, field, DisplayId, uint32_t,
                "The model it shows now, a CreatureDisplayInfo.dbc id.")
WXL_OBJECT_READ(Units, unit_native_display_id, UnitNativeDisplayId, uint32_t, field, NativeDisplayId, uint32_t,
                "The model it shows when nothing changes its shape.")
WXL_OBJECT_READ(Units, unit_mount_display_id, UnitMountDisplayId, uint32_t, field, MountDisplayId, uint32_t,
                "The model of its mount; 0 while not mounted.")
WXL_OBJECT_READ(Units, unit_faction_template, UnitFactionTemplate, uint32_t, field, FactionTemplate, uint32_t,
                "Its FactionTemplate.dbc id.")
WXL_OBJECT_READ(Units, unit_flags, UnitFlags, uint32_t, field, Flags, uint32_t,
                "UNIT_FIELD_FLAGS as the server sends it.")
WXL_OBJECT_READ(Units, unit_flags2, UnitFlags2, uint32_t, field, Flags2, uint32_t,
                "UNIT_FIELD_FLAGS_2 as the server sends it.")
WXL_OBJECT_READ(Units, unit_dynamic_flags, UnitDynamicFlags, uint32_t, field, DynamicFlags, uint32_t,
                "UNIT_DYNAMIC_FLAGS as the server sends it to this client.")
WXL_OBJECT_READ(Units, unit_npc_flags, UnitNpcFlags, uint32_t, field, NpcFlags, uint32_t,
                "What it offers to talk about: vendor, trainer, quest giver, ... as UNIT_NPC_FLAGS.")
WXL_OBJECT_READ(Units, unit_bounding_radius, UnitBoundingRadius, float, field, BoundingRadius, float,
                "The radius of its body, in yards.")
WXL_OBJECT_READ(Units, unit_combat_reach, UnitCombatReach, float, field, CombatReach, float,
                "How far it reaches in melee, in yards.")
WXL_OBJECT_READ(Units, unit_charm, UnitCharm, wxl_guid, field, CharmGuid, wxl_guid,
                "The unit it charms, or 0.")
WXL_OBJECT_READ(Units, unit_summon, UnitSummon, wxl_guid, field, SummonGuid, wxl_guid,
                "The unit it summoned, its pet among them, or 0.")
WXL_OBJECT_READ(Units, unit_charmed_by, UnitCharmedBy, wxl_guid, field, CharmedByGuid, wxl_guid,
                "Who charms it, or 0.")
WXL_OBJECT_READ(Units, unit_summoned_by, UnitSummonedBy, wxl_guid, field, SummonedByGuid, wxl_guid,
                "Who summoned it: a pet's owner, or 0.")
WXL_OBJECT_READ(Units, unit_created_by, UnitCreatedBy, wxl_guid, field, CreatedByGuid, wxl_guid,
                "Who created it: a totem's shaman, or 0.")

// --- Players -------------------------------------------------------------------------------

WXL_OBJECT_READ(Players, player_flags, PlayerFlags, uint32_t, field, Flags, uint32_t,
                "PLAYER_FLAGS as the server sends it.")
WXL_OBJECT_READ(Players, player_guild_id, PlayerGuildId, uint32_t, field, GuildId, uint32_t,
                "Its guild's id; 0 while unguilded.")
WXL_OBJECT_READ(Players, player_guild_rank, PlayerGuildRank, uint32_t, field, GuildRank, uint32_t,
                "Its rank in the guild, 0 for the guild master.")
WXL_OBJECT_READ(Players, player_chosen_title, PlayerChosenTitle, uint32_t, field, ChosenTitle, uint32_t,
                "The title it shows, a CharTitles.dbc bit index; 0 for none.")
