// --- Dynamic objects -----------------------------------------------------------------------

WXL_OBJECT_READ(Dynamics, dynamic_caster, DynamicCaster, wxl_guid, field, CasterGuid, wxl_guid,
                "The unit that cast it.")
WXL_OBJECT_READ(Dynamics, dynamic_spell_id, DynamicSpellId, uint32_t, field, SpellId, uint32_t,
