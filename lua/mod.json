{
  "$schema": "../schema/mod.json",
  "id": "wxl.lua",
  "name": "Lua",
  "version": "0.1.0",
  "abi": "0.1.5",
  "description": "Runs the Lua mods: every folder under Mods/ whose manifest names a \"lua\" entry.",
  "binaries": {
    "win-x64": "bin/x64/wxl-lua.dll",
    "win-x86": "bin/x86/wxl-lua.dll"
  },
  "net": { "stock": true },
  "optional": [
    { "service": "wxl.object", "version": 1 }
  ]
}
